{
  "name": "repolore",
  "version": "1.0.0",
  "private": true,
  "description": "Repo Lore builds a living mental model of your software, so every engineer can understand it with confidence — without relying on tribal knowledge.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --fix",
    "format": "prettier --write",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "npm test -- --watch",
    "discover": "tsx scripts/discover-fixture.ts",
    "extract": "tsx scripts/extract-fixture.ts",
    "extract-python": "tsx scripts/extract-python-fixture.ts",
    "derive": "tsx scripts/derive-fixture.ts",
    "derive-python": "tsx scripts/derive-python-fixture.ts",
    "analyze-repo": "tsx --env-file-if-exists=.env.local scripts/analyze-github-repo.ts",
    "analyze-python-repo": "tsx --env-file-if-exists=.env.local scripts/analyze-python-github-repo.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.3.5",
    "@radix-ui/react-tabs": "^1.1.19",
    "@tailwindcss/postcss": "^4.3.3",
    "ini": "^7.0.0",
    "lodash.startcase": "^4.4.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "postcss": "^8.5.22",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "smol-toml": "^1.7.1",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.21",
    "tree-sitter-python": "^0.25.0",
    "ts-morph": "^28.0.0",
    "web-tree-sitter": "^0.26.11"
  },
  "devDependencies": {
    "@types/ini": "^4.1.1",
    "@types/jest": "^30.0.0",
    "@types/lodash.startcase": "^4.4.9",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-jest": "^29.16.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nielse63/RepoLore.git"
  },
  "keywords": [],
  "author": "Erik Nielsen <erik@312development.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nielse63/RepoLore/issues"
  },
  "homepage": "https://github.com/nielse63/RepoLore#readme",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,md,json}": "prettier --write"
  }
}
