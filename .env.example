# GitHub personal access token, used to call the GitHub REST API.
# No scopes are required for reading public repositories — a token with no
# scopes selected (classic) or "Public Repositories (read-only)" access
# (fine-grained) is sufficient. Raises the API rate limit from 60/hr
# (unauthenticated) to 5,000/hr. Create one at https://github.com/settings/tokens.
GITHUB_TOKEN=

# Postgres connection string. `docker compose up -d db` runs a local Postgres
# matching these credentials; `npm run migrate` applies src/db/migrations/.
DATABASE_URL=

# Optional. The app's public origin, used to build absolute canonical/Open
# Graph/Twitter URLs (src/lib/route-metadata.ts). Must include a scheme, no
# trailing slash — e.g. https://repolore.example. Render sets its own
# equivalent (RENDER_EXTERNAL_URL) automatically, so this only needs to be
# set to override that, e.g. once a custom domain is attached. Falls back to
# http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=
